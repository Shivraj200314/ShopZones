{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",

  "version": 1,

  "newProjectRoot": "projects",

  "projects": {

    "ecommerce-products": {

      "projectType": "application",

      "schematics": {},

      "root": "",

      "sourceRoot": "src",

      "prefix": "app",

      "architect": {

        "build": {

          "builder": "ngx-build-plus:browser",

          "options": {

            "outputPath": "dist/ecommerce-products",

            "index": "src/index.html",

            "main": "src/main.ts",

            "polyfills": [
              "zone.js"
            ],

            "tsConfig": "tsconfig.app.json",

            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],

            "styles": [
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "src/styles.css"
            ],

            "scripts": [],

            "extraWebpackConfig": "webpack.config.js",

            "commonChunk": false
          },

          "configurations": {

            "production": {

              "budgets": [

                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },

                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }

              ],

              "outputHashing": "all",

              "extraWebpackConfig": "webpack.prod.config.js"
            },

            "development": {

              "buildOptimizer": false,

              "optimization": false,

              "vendorChunk": true,

              "extractLicenses": false,

              "sourceMap": true,

              "namedChunks": true
            }

          },

          "defaultConfiguration": "production"
        },


        "serve": {

          "builder": "ngx-build-plus:dev-server",

          "configurations": {

            "production": {

              "browserTarget":
                "ecommerce-products:build:production",

              "extraWebpackConfig":
                "webpack.prod.config.js"
            },

            "development": {

              "browserTarget":
                "ecommerce-products:build:development"
            }

          },

          "defaultConfiguration":
            "development",

          "options": {

            "port":
              4201,

            "publicHost":
              "http://localhost:4201",

            "extraWebpackConfig":
              "webpack.config.js"
          }

        },


        "extract-i18n": {

          "builder":
            "ngx-build-plus:extract-i18n",

          "options": {

            "browserTarget":
              "ecommerce-products:build",

            "extraWebpackConfig":
              "webpack.config.js"
          }

        },


        "test": {

          "builder":
            "@angular-devkit/build-angular:karma",

          "options": {

            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],

            "tsConfig":
              "tsconfig.spec.json",

            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],

            "styles": [
              "src/styles.css"
            ],

            "scripts": []

          }

        }

      }

    }

  },


  "cli": {

    "analytics":
      "98bc0ffa-6eed-4366-9143-b314dc4e4c42"

  }

}