{
  "extends": "./tsconfig.json",

  "compilerOptions": {

    "outDir": "./out-tsc/spec",

    "types": [
      "jest",
      "node"
    ],

    "module": "CommonJS",

    "target": "ES2016",

    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true
  },

  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}